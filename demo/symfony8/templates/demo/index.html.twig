{% extends 'base.html.twig' %}

{% block title %}Audit Kit Demo{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'Automatic audit fields',
        intro: 'Each refresh persists a new audited Article and a LegacyRecord with #[Auditable(enabled: false)] while simulating an authenticated user (' ~ user.email ~ ').',
    }) }}
{% endblock %}

{% block body %}
    <p><a class="nowo-ui-btn nowo-ui-btn--primary" href="{{ path('demo_home') }}">Persist another row</a></p>

    <section class="nowo-ui-card">
        <div class="nowo-ui-card__header">
            <h2 class="nowo-ui-card__title">Latest articles <span class="nowo-ui-badge nowo-ui-badge--success">audited</span></h2>
        </div>
        <div class="nowo-ui-card__body">
            <table class="nowo-ui-data-table">
                <thead><tr><th scope="col">Title</th><th scope="col">createdAt</th><th scope="col">updatedAt</th><th scope="col">createdBy</th><th scope="col">updatedBy</th></tr></thead>
                <tbody>
                {% for article in articles %}
                    <tr>
                        <th scope="row">{{ article.title }}</th>
                        <td>{{ article.createdAt ? article.createdAt|date('Y-m-d H:i:s') : '—' }}</td>
                        <td>{{ article.updatedAt ? article.updatedAt|date('Y-m-d H:i:s') : '—' }}</td>
                        <td>{{ article.createdBy ? article.createdBy.email : 'null' }}</td>
                        <td>{{ article.updatedBy ? article.updatedBy.email : 'null' }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="5">No articles yet.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <section class="nowo-ui-card">
        <div class="nowo-ui-card__header">
            <h2 class="nowo-ui-card__title">Latest legacy records <span class="nowo-ui-badge nowo-ui-badge--neutral">#[Auditable(enabled: false)]</span></h2>
        </div>
        <div class="nowo-ui-card__body">
            <table class="nowo-ui-data-table">
                <thead><tr><th scope="col">Label</th><th scope="col">createdAt</th><th scope="col">updatedAt</th><th scope="col">createdBy</th><th scope="col">updatedBy</th></tr></thead>
                <tbody>
                {% for record in legacyRecords %}
                    <tr>
                        <th scope="row">{{ record.label }}</th>
                        <td>{{ record.createdAt ? record.createdAt|date('Y-m-d H:i:s') : '—' }}</td>
                        <td>{{ record.updatedAt ? record.updatedAt|date('Y-m-d H:i:s') : '—' }}</td>
                        <td>{{ record.createdBy ? record.createdBy.email : 'null' }}</td>
                        <td>{{ record.updatedBy ? record.updatedBy.email : 'null' }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="5">No legacy records yet.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
